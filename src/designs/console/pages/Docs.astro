---
import Base from '../../../layouts/Base.astro';
import PageIntro from '../PageIntro.astro';
import { specs, specification, organization, url } from '../../../data/site';
---

<Base
  title="Specifications and documentation"
  description="Find the seven ANS specification layers, discovery profiles, API contracts, worked examples, SDKs, and security analysis."
>
  <PageIntro
    title="The specification is the source of truth."
    description="ANS is defined in seven layers, with separate API contracts and worked examples. Use the canonical documents for normative requirements."
  >
    <div class="actions">
      <a class="btn btn--primary" href={`${specification}/tree/main/spec`}>
        Browse the specification
      </a>
      <a class="text-link" href={url('for-developers/')}>
        New to ANS? Start here
      </a>
    </div>
  </PageIntro>
  <section class="container content-section">
    <h2>Seven layers, from identity to authentication.</h2>
    <ol class="layers">
      {specs.map((spec) => (
        <li>
          <a href={`${specification}/blob/main/spec/${spec.file}`}>
            <span class="measured">{spec.id}</span>
            <strong>{spec.title}</strong>
            <p>{spec.description}</p>
          </a>
        </li>
      ))}
    </ol>
    <p class="section-note">
      The specifications are drafts under active development. The links above
      point to the current documents in the specification repository.
    </p>
  </section>
  <section class="container content-section">
    <h2>Implement the contract.</h2>
    <div class="panels panels--2">
      <article>
        <h3>API definitions: registration and transparency</h3>
        <p>
          Machine-readable OpenAPI definitions for the Registration Authority
          and Transparency Log, plus the V2 event schemas.
        </p>
        <ul class="links">
          <li>
            <a
              class="text-link"
              href={`${specification}/blob/main/api/api-spec-v2.yaml`}
            >
              Registration API
            </a>
          </li>
          <li>
            <a
              class="text-link"
              href={`${specification}/blob/main/api/api-spec-tl-v2.yaml`}
            >
              Transparency Log API
            </a>
          </li>
          <li>
            <a class="text-link" href={`${specification}/tree/main/api`}>
              Event and response schemas
            </a>
          </li>
        </ul>
      </article>
      <article>
        <h3>Worked examples: follow the artifacts</h3>
        <p>
          Read registration, transparency, integrity-monitoring, and
          authentication examples alongside their specifications.
        </p>
        <ul class="links">
          <li>
            <a
              class="text-link"
              href={`${specification}/tree/main/spec/examples`}
            >
              Protocol examples
            </a>
          </li>
          <li>
            <a class="text-link" href={`${organization}/ans`}>
              Runnable reference implementation
            </a>
          </li>
        </ul>
      </article>
      <article>
        <h3>Profiles: discovery and identity</h3>
        <p>
          DNS publication profiles define discovery records. Optional identity
          profiles define additional proofs and their verification requirements.
        </p>
        <ul class="links">
          <li>
            <a
              class="text-link"
              href={`${specification}/tree/main/spec/discovery-profiles`}
            >
              Discovery profiles
            </a>
          </li>
          <li>
            <a
              class="text-link"
              href={`${specification}/tree/main/spec/identity-profiles`}
            >
              Identity profiles
            </a>
          </li>
        </ul>
      </article>
      <article>
        <h3>Security: review the assumptions</h3>
        <p>
          The MAESTRO analysis maps threats and mitigations across the
          architecture. Each protocol layer also includes its security
          considerations.
        </p>
        <ul class="links">
          <li>
            <a class="text-link" href={`${specification}/blob/main/MAESTRO.md`}>
              Security analysis
            </a>
          </li>
          <li>
            <a
              class="text-link"
              href={`${specification}/blob/main/SECURITY.md`}
            >
              Vulnerability reporting
            </a>
          </li>
        </ul>
      </article>
    </div>
  </section>
</Base>
