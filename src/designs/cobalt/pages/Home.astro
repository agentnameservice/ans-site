---
import Base from '../../../layouts/Base.astro';
import { url, organization, sdks } from '../../../data/site';
---

<Base
  title="Verifiable identity for AI agents"
  description="Agent Name Service is an open specification for naming, discovering, and authenticating AI agents. Read the specification, try an implementation, or contribute."
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>Verifiable identity for AI agents</h1>
        <p class="lead">
          An open specification for naming, discovering and authenticating AI
          agents.
        </p>
        <div class="actions">
          <a class="key key--primary" href={url('docs/')}>
            Read the specification
          </a>
          <a class="key" href={url('for-developers/')}>
            Try an implementation
          </a>
        </div>
      </div>
      <figure
        class="system-map"
        aria-label="How a peer verifies an ANS identity"
      >
        <ol class="system-map-list">
          <li class="node node--domain cut">
            <p class="node-name">Domain</p>
            <p class="mono">payments.example.com</p>
            <p class="mono node-value">ans://v1.0.0.payments.example.com</p>
            <dl class="facts">
              <div>
                <dt>Publishes</dt>
                <dd>The DNS records the RA returns</dd>
              </div>
              <div>
                <dt>Badge record</dt>
                <dd>
                  <span class="mono">_ans-badge</span>
                </dd>
              </div>
            </dl>
          </li>
          <li class="edge edge--top" aria-hidden="true">
            <p>Proves control</p>
          </li>
          <li class="node node--ra cut">
            <p class="node-name">Registration Authority</p>
            <dl class="facts">
              <div>
                <dt>Checks</dt>
                <dd>Domain control, proof of key possession</dd>
              </div>
              <div>
                <dt>Returns</dt>
                <dd>The DNS records to publish</dd>
              </div>
            </dl>
          </li>
          <li class="edge edge--right" aria-hidden="true">
            <p>Signs the event, the log seals it</p>
          </li>
          <li class="node node--log cut">
            <p class="node-name">Transparency Log</p>
            <dl class="facts">
              <div>
                <dt>Badge</dt>
                <dd>
                  <span class="mono">_ans-badge.payments.example.com</span>
                </dd>
              </div>
              <div>
                <dt>Receipt</dt>
                <dd>
                  <span class="mono">SCITT</span>
                </dd>
              </div>
              <div>
                <dt>Event</dt>
                <dd>Sealed before activation</dd>
              </div>
            </dl>
          </li>
          <li class="edge edge--bottom" aria-hidden="true">
            <p>
              Badge and receipt
              <span class="phone-only">
                . Discovers the domain through DNS.
              </span>
            </p>
          </li>
          <li class="node node--peer cut">
            <p class="node-name">Peer</p>
            <dl class="facts">
              <div>
                <dt>Identity</dt>
                <dd>Bound to a domain</dd>
              </div>
              <div>
                <dt>Status</dt>
                <dd>Registration is current</dd>
              </div>
              <div>
                <dt>Possession</dt>
                <dd>Key holder authenticated</dd>
              </div>
            </dl>
          </li>
          <li class="edge edge--left" aria-hidden="true">
            <p>Discovers</p>
          </li>
        </ol>
        <ol class="visually-hidden">
          <li>The domain proves control to the Registration Authority.</li>
          <li>
            The Registration Authority signs the event and the Transparency Log
            seals it.
          </li>
          <li>
            The Transparency Log supplies the badge and receipt to the peer.
          </li>
          <li>The peer discovers the domain through DNS.</li>
        </ol>
        <figcaption>
          <span>Illustrative example</span>
          <span>
            The published specifications are drafts under active development.
          </span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section
    class="section section--l"
    id="watch"
    aria-labelledby="video-heading"
  >
    <div class="container">
      <div class="cols head-split">
        <h2 id="video-heading" class="col-1-6">
          What is ANS?
        </h2>
        <p id="video-summary" class="lead col-7-12">
          A short introduction to agent identity and why it matters when AI
          agents interact.
        </p>
      </div>
      <figure class="showcase">
        <video
          controls
          playsinline
          preload="none"
          width="1920"
          height="1080"
          poster={url('videos/ans-explainer-poster.jpg')}
          aria-labelledby="video-heading"
          aria-describedby="video-summary"
        >
          <source src={url('videos/ans-explainer.mp4')} type="video/mp4" />
          <track
            kind="captions"
            src={url('videos/ans-explainer.en.vtt')}
            srclang="en"
            label="English"
          />
          <p>
            <a href={url('videos/ans-explainer.mp4')}>
              Download the ANS overview
            </a>
            to watch it in your video player.
          </p>
        </video>
        <figcaption>
          <span>1 min 52 sec</span>
          <span>English captions available</span>
          <a href={url('videos/ans-explainer.mp4')} download>
            Download video
          </a>
        </figcaption>
      </figure>
      <p class="after">
        <a class="text-link" href={url('how-it-works/')}>
          How ANS works
        </a>
      </p>
    </div>
  </section>

  <section class="section section--s">
    <div class="container">
      <div class="cols head-split">
        <h2 class="col-1-6">Build with ANS</h2>
        <p class="lead col-7-12">
          Run the Registration Authority and Transparency Log locally, inspect a
          registration, and verify its receipt.
        </p>
      </div>
      <div
        class="table-wrap"
        tabindex="0"
        role="region"
        aria-label="Implementations and SDKs"
      >
        <table class="ruled-table">
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Repository</th>
              <th scope="col">What it holds</th>
              <th scope="col">Scope</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Reference implementation</th>
              <td data-label="Repository">
                <a class="mono nowrap" href={`${organization}/ans`}>
                  ans
                </a>
              </td>
              <td data-label="What it holds">
                Go. Registration Authority, Transparency Log, and offline
                verifier.
              </td>
              <td data-label="Scope">Reference</td>
            </tr>
            {sdks.map((sdk) => (
              <tr>
                <th scope="row">{sdk.name}</th>
                <td data-label="Repository">
                  <a class="mono nowrap" href={`${organization}/${sdk.repo}`}>
                    {sdk.repo}
                  </a>
                </td>
                <td data-label="What it holds">{sdk.detail}</td>
                <td data-label="Scope">{sdk.label}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="after">
        <a class="text-link" href={url('ecosystem/')}>
          Browse all implementations
        </a>
      </p>
    </div>
  </section>

  <section class="section section--s" aria-label="Reference quickstart">
    <div class="container cols">
      <div class="graphite cut panel col-1-10">
        <pre><code><span class="token">git</span> clone https://github.com/agentnameservice/ans
<span class="token">cd</span> ans
<span class="token">make</span> build
<span class="token">scripts/demo/start.sh</span></code></pre>
        <div class="panel-foot">
          <p>
            Look for <code>VERIFIED</code> in the offline-verification stage.
          </p>
          <a class="key key--dark" href={url('for-developers/')}>
            Get started
          </a>
        </div>
      </div>
    </div>
  </section>

  <section
    class="section section--s close"
    aria-labelledby="participate-heading"
  >
    <div class="container ruled">
      <h2 id="participate-heading" class="close-head">
        Participate in the project
      </h2>
      <p class="statement">
        ANS establishes identity. Applications still decide what a peer may do.
      </p>
      <p class="actions">
        <a class="key" href={url('community/')}>
          How to contribute
        </a>
        <a class="key" href={organization}>
          Find a project
        </a>
      </p>
      <p class="after">
        <a class="text-link" href={url('how-it-works/')}>
          How verification works
        </a>
      </p>
    </div>
  </section>
</Base>
