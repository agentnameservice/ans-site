---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Content from '@design-pages/Content.astro';

interface Props {
  frontmatter: {
    title: string;
    eyebrow: string;
    heading: string;
    description: string;
    noindex?: boolean;
  };
  headings: MarkdownHeading[];
}
const {
  frontmatter: { title, eyebrow, heading, description, noindex = false },
  headings,
} = Astro.props;
---

<Base title={title} description={description} noindex={noindex}>
  <Content
    eyebrow={eyebrow}
    heading={heading}
    description={description}
    headings={headings}
  >
    <slot />
  </Content>
</Base>
