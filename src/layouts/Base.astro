---
import Shell from '@design/Shell.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
---

<Shell
  title={title}
  description={description}
  noindex={noindex || import.meta.env.SITE_DESIGN_PREVIEW}
>
  <slot />
</Shell>
