{
  "name": "ans-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node scripts/check-site.mjs",
    "verify": "npm run format:check && npm run check && npm run build && npm test && npm run build:preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:preview": "node scripts/build-preview.mjs",
    "preview:designs": "node scripts/serve-preview.mjs"
  },
  "dependencies": {
    "@fontsource-variable/familjen-grotesk": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/host-grotesk": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.23.4"
  }
